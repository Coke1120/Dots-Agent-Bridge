# Documentation placeholders only. The server does not automatically load this file.
BRIDGE_RESOURCE=https://bridge.example.com/mcp
OAUTH_ISSUER=https://YOUR-TENANT.auth0.com/
OAUTH_JWKS_URL=https://YOUR-TENANT.auth0.com/.well-known/jwks.json
# Auth0 default access-token profile uses azp; other providers may use client_id.
# Select exactly the signed access-token claim documented by your provider.
OAUTH_CLIENT_CLAIM=azp
BRIDGE_POLICY=/var/lib/hermes-dots-bridge/policy.json
BRIDGE_DB=/var/lib/hermes-dots-bridge/bridge.sqlite
BRIDGE_ENCRYPTION_KEY=REPLACE_WITH_SECRET_MANAGER_FERNET_KEY
# Exact observed and independently verified ChatGPT callback hostname(s), no wildcards.
BRIDGE_CALLBACK_HOSTS=REPLACE_WITH_VERIFIED_CALLBACK_HOST
